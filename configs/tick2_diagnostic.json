{
  "experiment": {
    "minutes_per_tick": 2,
    "output_root": "outputs",
    "run_name_template": "{scale}_tick2_latest"
  },
  "environment": {
    "zone_count": 16,
    "scenario_source": "tlc_manhattan",
    "allow_synthetic_smoke_fallback": true,
    "tlc_trip_path": "yellow_tripdata_2025-10.parquet",
    "taxi_zone_lookup_path": "taxi_zone_lookup.csv",
    "taxi_zone_geo_path": "",
    "processed_dir": "data/processed",
    "manhattan_only": true,
    "travel_time_source": "empirical_median",
    "tick_minutes": 2,
    "time_bucket_minutes": 60,
    "demand_sample_rate": 0.35,
    "supply_scale": 0.55,
    "max_candidate_vehicles_per_order": 20,
    "train_days": [],
    "eval_days": [],
    "service_kwh_per_tick": 1.8,
    "pickup_cap_minutes": 18.0,
    "platform_pickup_cost_per_min": 0.06,
    "dispatch_friction": {
      "enabled": true,
      "setup_cost": 18.0,
      "pair_coordination_cost": 0.75,
      "full_mode_extra_pair_cost": 0.20,
      "refresh_cost": 16.0,
      "refresh_decay_ticks": 2.25
    },
    "wait_penalty_per_order_tick": 0.006,
    "expired_penalty": 10.0,
    "cancelled_penalty": 8.0,
    "service_rate_target": 0.62,
    "urgent_service_rate_target": 0.72,
    "expired_rate_cap": 0.16,
    "cancelled_rate_cap": 0.10,
    "mean_pickup_soft_cap_min": 10.0,
    "mean_commitment_soft_cap_ticks": 10.5,
    "profit_scale_fallback": 5.0,
    "pickup_distance_penalty_per_km": 0.05,
    "enable_stochastic_acceptance": true,
    "enable_stochastic_cancellation": true,
    "service_risk_delta_weight": 0.12,
    "service_risk_delta_clip": 35.0,
    "wait_opportunity_weight": 0.02,
    "wait_opportunity_cap": 1200.0,
    "battery_health": {
      "donor_min_soc_ratio": 0.25,
      "transfer_efficiency": 0.90,
      "degradation_cost_per_kwh": 0.08,
      "max_discharge_power_kw": 50.0
    }
  },
  "scales": {
    "smoke": {
      "horizon_ticks": 90,
      "terminal_buffer_ticks": 12,
      "total_orders": 80,
      "candidate_vehicles": 120,
      "vehicle_join_probability": 0.55,
      "fleet_probability": 0.08,
      "train_episodes": 20,
      "eval_episodes": 8
    },
    "main": {
      "horizon_ticks": 120,
      "terminal_buffer_ticks": 21,
      "total_orders": 1600,
      "candidate_vehicles": 1900,
      "vehicle_join_probability": 0.36,
      "fleet_probability": 0.09,
      "train_episodes": 150,
      "eval_episodes": 80
    }
  },
  "training": {
    "gamma": 0.98,
    "learning_rate": 0.0005,
    "batch_size": 128,
    "replay_capacity": 50000,
    "min_replay_size": 500,
    "target_update_interval": 100,
    "epsilon_start": 1.0,
    "epsilon_end": 0.08,
    "epsilon_decay_steps": 3500,
    "teacher_prefill_episodes": 8,
    "validation_episodes": 16,
    "validation_interval_episodes": 10,
    "checkpoint_selection_metric": "future_v2v_score_mean",
    "hidden_dim": 128,
    "double_dqn": true,
    "prioritized_replay": true,
    "rollout_workers": 4,
    "validation_time_buckets": ["morning_peak", "midday", "evening_peak", "off_peak"],
    "validation_worst_bucket_weight": 0.15,
    "validation_off_peak_score_floor": 0.0
  }
}
