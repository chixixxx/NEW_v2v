{
  "experiment": {
    "minutes_per_tick": 3,
    "output_root": "outputs",
    "run_name_template": "{scale}_latest"
  },
  "environment": {
    "zone_count": 16,
    "scenario_source": "tlc_manhattan",
    "allow_synthetic_smoke_fallback": true,
    "tlc_trip_path": "yellow_tripdata_2025-10.parquet",
    "taxi_zone_lookup_path": "taxi_zone_lookup.csv",
    "taxi_zone_geo_path": "",
    "processed_dir": "data/processed",
    "manhattan_only": true,
    "travel_time_source": "empirical_median",
    "tick_minutes": 3,
    "time_bucket_minutes": 60,
    "demand_sample_rate": 0.35,
    "supply_scale": 0.55,
    "max_candidate_vehicles_per_order": 20,
    "train_days": [],
    "eval_days": [],
    "service_kwh_per_tick": 2.7,
    "pickup_cap_minutes": 18.0,
    "platform_pickup_cost_per_min": 0.06,
    "dispatch_friction": {
      "enabled": true,
      "setup_cost": 18.0,
      "pair_coordination_cost": 0.75,
      "full_mode_extra_pair_cost": 0.20,
      "refresh_cost": 16.0,
      "refresh_decay_ticks": 1.5
    },
    "wait_penalty_per_order_tick": 0.008,
    "expired_penalty": 10.0,
    "cancelled_penalty": 8.0,
    "service_rate_target": 0.62,
    "urgent_service_rate_target": 0.72,
    "expired_rate_cap": 0.16,
    "cancelled_rate_cap": 0.10,
    "mean_pickup_soft_cap_min": 10.0,
    "mean_commitment_soft_cap_ticks": 7.0,
    "profit_scale_fallback": 5.0,
    "pickup_distance_penalty_per_km": 0.05,
    "observation_profile": "compact_v2v",
    "enable_stochastic_acceptance": true,
    "enable_stochastic_cancellation": true,
    "service_risk_delta_weight": 0.12,
    "service_risk_delta_clip": 35.0,
    "wait_opportunity_weight": 0.02,
    "wait_opportunity_cap": 1200.0,
    "battery_health": {
      "donor_min_soc_ratio": 0.25,
      "transfer_efficiency": 0.90,
      "degradation_cost_per_kwh": 0.08,
      "max_discharge_power_kw": 50.0
    }
  },
  "scales": {
    "smoke": {
      "horizon_ticks": 60,
      "terminal_buffer_ticks": 8,
      "total_orders": 80,
      "candidate_vehicles": 120,
      "vehicle_join_probability": 0.55,
      "fleet_probability": 0.08,
      "train_episodes": 20,
      "eval_episodes": 8
    },
    "main": {
      "horizon_ticks": 80,
      "terminal_buffer_ticks": 14,
      "total_orders": 1600,
      "candidate_vehicles": 1900,
      "vehicle_join_probability": 0.36,
      "fleet_probability": 0.09,
      "train_episodes": 150,
      "eval_episodes": 80
    }
  },
  "training": {
    "gamma": 0.98,
    "learning_rate": 0.0005,
    "batch_size": 128,
    "replay_capacity": 50000,
    "min_replay_size": 500,
    "target_update_interval": 100,
    "epsilon_start": 1.0,
    "epsilon_end": 0.08,
    "epsilon_decay_steps": 3500,
    "teacher_prefill_episodes": 8,
    "validation_episodes": 16,
    "validation_interval_episodes": 10,
    "checkpoint_selection_metric": "future_v2v_score_mean",
    "hidden_dim": 128,
    "double_dqn": true,
    "prioritized_replay": true,
    "agent_type": "ppo",
    "rollout_workers": 4,
    "ppo_rollout_episodes_per_update": 4,
    "ppo_epochs": 4,
    "ppo_clip_ratio": 0.20,
    "ppo_value_loss_coef": 0.50,
    "ppo_entropy_coef": 0.035,
    "ppo_gae_lambda": 0.95,
    "ppo_max_grad_norm": 5.0,
    "ppo_eval_deterministic": false,
    "ppo_reward_scale": 1000.0,
    "ppo_value_clip_range": 0.20,
    "teacher_imitation_epochs": 2,
    "teacher_imitation_batch_size": 256,
    "validation_action_max_share_cap": 0.85,
    "validation_interval_max_share_cap": 0.75,
    "validation_action_balance_penalty": 600.0,
    "validation_min_mean_interval": 1.15,
    "validation_max_mean_interval": 2.45,
    "reward_shaping_mode": "pbrs",
    "pbrs_clip": 250.0,
    "pbrs_terminal_mode": "finite_horizon_correction",
    "observation_profile": "compact_v2v",
    "potential_candidate_margin_weight": 0.10,
    "potential_feasible_density_weight": 35.0,
    "potential_urgent_coverage_weight": 25.0,
    "potential_pickup_time_weight": 1.2,
    "potential_pickup_distance_weight": 1.0,
    "potential_service_risk_weight": 0.04,
    "potential_urgent_service_risk_weight": 18.0,
    "potential_near_deadline_weight": 30.0,
    "potential_soc_binding_weight": 20.0,
    "validation_time_buckets": ["morning_peak", "midday", "evening_peak", "off_peak"],
    "validation_worst_bucket_weight": 0.15,
    "validation_off_peak_score_floor": 0.0
  }
}
